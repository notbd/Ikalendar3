    "credits.disclaimer" : {
      "comment" : "Credits footer: the app is not affiliated with Nintendo. ikalendar3 is the app's name; Splatoon 3 uses the game's official title.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ikalendar3 ist eine inoffizielle Begleit-App zu Splatoon 3 und steht in keiner Verbindung zu Nintendo. Alle zugehörigen Namen, Logos und Marken sind Eigentum ihrer jeweiligen Inhaber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ikalendar3 is a third-party companion app for Splatoon 3 and is not affiliated with Nintendo. All associated names, logos and trademarks are the property of their respective owners."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ikalendar3 is a third-party companion app for Splatoon 3 and is not affiliated with Nintendo. All associated names, logos and trademarks are the property of their respective owners."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ikalendar3 es una app complementaria no oficial de Splatoon 3 y no está afiliada a Nintendo. Todos los nombres, logotipos y marcas relacionados pertenecen a sus respectivos propietarios."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ikalendar3 es una app complementaria no oficial de Splatoon 3 y no está afiliada a Nintendo. Todos los nombres, logotipos y marcas relacionados pertenecen a sus respectivos propietarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ikalendar3 est une app compagnon non officielle pour Splatoon 3, sans lien avec Nintendo. Les noms, logos et marques associés appartiennent à leurs propriétaires respectifs."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ikalendar3 est une application compagnon non officielle pour Splatoon 3, sans lien avec Nintendo. Les noms, logos et marques associés appartiennent à leurs propriétaires respectifs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ikalendar3 è un’app di supporto non ufficiale per Splatoon 3 e non è affiliata a Nintendo. Tutti i nomi, i loghi e i marchi associati appartengono ai rispettivi proprietari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ikalendar3」は「スプラトゥーン3」の非公式のコンパニオンアプリであり、任天堂とは関係ありません。関連するすべての名称、ロゴ、商標はそれぞれの所有者に帰属します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ikalendar3는 스플래툰 3의 비공식 컴패니언 앱이며 Nintendo와 관련이 없습니다. 관련된 모든 이름, 로고 및 상표의 권리는 각 소유자에게 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ikalendar3 is een onofficiële hulpapp voor Splatoon 3 en is niet verbonden aan Nintendo. Alle bijbehorende namen, logo’s en handelsmerken zijn eigendom van hun respectieve eigenaren."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ikalendar3 является неофициальным приложением-компаньоном для Splatoon 3 и не связано с Nintendo. Все связанные названия, логотипы и товарные знаки принадлежат их владельцам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ikalendar3 是《斯普拉遁3》的非官方辅助 App，与任天堂无关。所有相关名称、标志和商标均归各自所有者所有。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ikalendar3 是《斯普拉遁3》的非官方輔助 App，與任天堂無關。所有相關名稱、標誌和商標均歸各自所有者所有。"
          }
        }
      }
    },
    "credits.fontNote" : {
      "comment" : "Credits section footer: whose fonts the app's text uses. SplatNet 3 uses its official name in each language.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Text verwendet die Schriften von SplatNet 3: Nintendos Splatoon-Schriften mit Kanji von Fontworks, Hanzi von DynaComware und Hangul von AsiaSoft. Sie bleiben Eigentum ihrer jeweiligen Inhaber."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text uses SplatNet 3’s fonts: Nintendo’s Splatoon faces, with kanji by Fontworks, hanzi by DynaComware and Hangul by AsiaSoft. Each remains the property of its owner."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text uses SplatNet 3’s fonts: Nintendo’s Splatoon faces, with kanji by Fontworks, hanzi by DynaComware and Hangul by AsiaSoft. Each remains the property of its owner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El texto usa las fuentes de SplatNet 3: las tipografías de Splatoon de Nintendo, con kanji de Fontworks, hanzi de DynaComware y hangul de AsiaSoft. Cada una pertenece a su propietario."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El texto usa las fuentes de SplatNet 3: las tipografías de Splatoon de Nintendo, con kanji de Fontworks, hanzi de DynaComware y hangul de AsiaSoft. Cada una pertenece a su propietario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le texte utilise les polices de SplatNet 3 : les polices Splatoon de Nintendo, avec les kanji de Fontworks, les hanzi de DynaComware et le hangul d’AsiaSoft. Chacune reste la propriété de son détenteur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le texte utilise les polices de SplatNet 3 : les polices Splatoon de Nintendo, avec les kanji de Fontworks, les hanzi de DynaComware et le hangul d’AsiaSoft. Chacune reste la propriété de son détenteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il testo usa i caratteri di SplatNet 3: i caratteri Splatoon di Nintendo, con kanji di Fontworks, hanzi di DynaComware e hangul di AsiaSoft. Ciascuno resta di proprietà del rispettivo titolare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字にはイカリング3のフォントを使用しています。任天堂のスプラトゥーン書体に、日本語の漢字はフォントワークス、中国語の漢字はダイナコムウェア、ハングルはAsiaSoftの書体を組み合わせています。各書体の権利はそれぞれの所有者に帰属します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "텍스트에는 오징어링 3의 글꼴을 사용합니다. Nintendo의 스플래툰 서체에 Fontworks의 일본어 한자, DynaComware의 중국어 한자, AsiaSoft의 한글을 더했습니다. 각 글꼴의 권리는 해당 소유자에게 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De tekst gebruikt de lettertypen van SplatNet 3: de Splatoon-lettertypen van Nintendo, met kanji van Fontworks, hanzi van DynaComware en Hangul van AsiaSoft. Ze blijven eigendom van hun respectieve eigenaren."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В тексте используются шрифты SplatNet 3: шрифты Splatoon от Nintendo, кандзи от Fontworks, ханьцзы от DynaComware и хангыль от AsiaSoft. Все они остаются собственностью своих владельцев."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字使用鱿鱼圈3的字体：任天堂的斯普拉遁字体，日文汉字来自 Fontworks，中文汉字来自 DynaComware，韩文来自 AsiaSoft。各字体的权利归其所有者所有。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字使用魷魚圈3的字型：任天堂的斯普拉遁字型，日文漢字來自 Fontworks，中文漢字來自 DynaComware，韓文來自 AsiaSoft。各字型的權利歸其所有者所有。"
          }
        }
      }
    },
