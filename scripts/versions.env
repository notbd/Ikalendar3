# Pinned toolchain, read by scripts/verify.sh, .github/workflows/ci.yml and scripts/assets.sh.
# CI selects exactly this Xcode and installs exactly these linters; verify.sh refuses other linter
# versions, because rule behaviour changes between releases.
XCODE_VERSION=27.2
SWIFTFORMAT_VERSION=0.64.5
SWIFTLINT_VERSION=0.65.1
# The asset script's Python; its packages are pinned in scripts/assets/requirements.txt.
ASSET_PYTHON_VERSION=3.14
