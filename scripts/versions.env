# Pinned toolchain, read by scripts/verify.sh and .github/workflows/ci.yml.
# CI selects exactly this Xcode and installs exactly these linters; verify.sh refuses other linter
# versions, because rule behaviour changes between releases.
XCODE_VERSION=27.2
SWIFTFORMAT_VERSION=0.64.5
SWIFTLINT_VERSION=0.65.1
# SHA-256 of the release assets CI downloads (swiftformat.zip, portable_swiftlint.zip). Update
# them with the versions; GitHub lists each asset's digest on its release.
SWIFTFORMAT_SHA256=ec017c91fdd46233e5a22dc43ff9564a3cc4b37023d3b4681b6c7d7b781de113
SWIFTLINT_SHA256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0
